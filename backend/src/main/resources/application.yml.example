server:
  port: 8080

spring:
  application:
    name: media-tracker
  datasource:
    url: jdbc:mysql://localhost:3306/media_tracker?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
    username: root
    password: changeme
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.MySQLDialect
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 5MB

app:
  jwt:
    # Generate a real 256-bit+ secret for production, e.g.: openssl rand -base64 32
    secret: "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES"
    expiration-ms: 86400000   # 24 hours
  cors:
    allowed-origins: "http://localhost:5173"

springdoc:
  swagger-ui:
    path: /swagger-ui.html
